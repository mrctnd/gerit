[Unit]
Description=Gerit SQLite yedeği

[Service]
Type=oneshot
User=gerit
Group=gerit
EnvironmentFile=/etc/gerit/gerit.env
Environment=BACKUP_DIR=/var/backups/gerit
Environment=RETENTION_DAYS=30
ExecStart=/usr/local/sbin/gerit-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/gerit
ReadOnlyPaths=/var/lib/gerit
