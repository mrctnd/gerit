[Unit]
Description=TodoSlate kişisel iş yöneticisi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=todoslate
Group=todoslate
WorkingDirectory=/opt/todoslate/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/todoslate/todoslate.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/todoslate

[Install]
WantedBy=multi-user.target
