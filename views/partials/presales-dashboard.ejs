<div class="presales-dashboard">
  <section class="presales-summary" aria-label="Presales portföy özeti">
    <article>
      <span>Aktif dosya</span>
      <strong><%= presalesSummary.active %></strong>
      <small>açık fırsat ve ihale</small>
    </article>
    <article class="<%= presalesSummary.dueSoon ? 'summary-active' : '' %>">
      <span>7 gün içinde</span>
      <strong><%= presalesSummary.dueSoon %></strong>
      <small>yaklaşan son tarih</small>
    </article>
    <article class="<%= presalesSummary.overdue ? 'summary-danger' : '' %>">
      <span>Geciken</span>
      <strong><%= presalesSummary.overdue %></strong>
      <small>termini geçen dosya</small>
    </article>
    <article class="<%= presalesSummary.noncompliant ? 'summary-danger' : '' %>">
      <span>Uygunsuz</span>
      <strong><%= presalesSummary.noncompliant %></strong>
      <small>değişiklik gereken kayıt</small>
    </article>
    <article class="<%= presalesSummary.criticalRisks ? 'summary-danger' : '' %>">
      <span>Kritik risk</span>
      <strong><%= presalesSummary.criticalRisks %></strong>
      <small><%= presalesSummary.clarification %> teyit bekliyor</small>
    </article>
    <article class="<%= presalesSummary.overdueActions ? 'summary-danger' : '' %>">
      <span>Geciken aksiyon</span>
      <strong><%= presalesSummary.overdueActions %></strong>
      <small><%= presalesSummary.openActions %> açık iç teslim işi</small>
    </article>
  </section>

  <% if (presalesSummary.pipeline.length) { %>
    <section class="pipeline-strip" aria-label="Ağırlıklı fırsat havuzu">
      <div><span>Ağırlıklı pipeline</span><small>Teklif bedeli × kazanma olasılığı</small></div>
      <% presalesSummary.pipeline.forEach((pipeline) => { %>
        <dl><div><dt><%= pipeline.currency %> toplam</dt><dd><%= formatMoney(pipeline.total, pipeline.currency) %></dd></div><div><dt>Ağırlıklı</dt><dd><%= formatMoney(pipeline.weighted, pipeline.currency) %></dd></div></dl>
      <% }) %>
    </section>
  <% } %>

  <section class="presales-section" aria-labelledby="active-cases-title">
    <div class="presales-section-heading">
      <div>
        <p class="eyebrow">Portföy</p>
        <h2 id="active-cases-title">Presales dosyaları</h2>
      </div>
      <div class="portfolio-tools">
        <label><span class="sr-only">Portföyde filtrele</span><input type="search" data-case-filter placeholder="Müşteri, proje veya model filtrele"></label>
        <a class="primary-button" href="#new-presales-case">Yeni dosya</a>
      </div>
    </div>

    <% if (cases.length) { %>
      <div class="presales-case-list">
        <% cases.forEach((presalesCase) => { %>
          <a class="presales-case-row <%= presalesCase.deadlineMeta.overdue && !['won', 'lost'].includes(presalesCase.stage) ? 'is-overdue' : '' %>" href="/presales/<%= presalesCase.id %>" data-case-row data-case-search="<%= [presalesCase.title, presalesCase.customer, presalesCase.tenderReference, ...presalesCase.products.flatMap((product) => [product.manufacturer, product.productFamily, product.proposedModel])].join(' ').toLocaleLowerCase('tr-TR') %>">
            <span class="presales-case-main">
              <strong><%= presalesCase.title %></strong>
              <small><%= [presalesCase.customer, presalesCase.tenderReference].filter(Boolean).join(' · ') || 'Müşteri ve referans bekleniyor' %></small>
              <span class="presales-inline-meta">
                <% presalesCase.products.slice(0, 3).forEach((product) => { %>
                  <span><%= [product.manufacturer, product.proposedModel].filter(Boolean).join(' · ') || product.productFamily %></span>
                <% }) %>
                <% if (presalesCase.products.length > 3) { %><span>+<%= presalesCase.products.length - 3 %> ürün</span><% } %>
                <% if (presalesCase.deadlineMeta.label) { %><span class="<%= presalesCase.deadlineMeta.overdue ? 'text-danger' : '' %>"><%= presalesCase.deadlineMeta.label %></span><% } %>
              </span>
            </span>
            <span class="presales-case-health">
              <span><span class="status-chip status-<%= presalesCase.stageMeta.tone %>"><%= presalesCase.stageMeta.label %></span><span class="status-chip status-<%= presalesCase.priorityMeta.tone %>"><%= presalesCase.priorityMeta.label %></span></span>
              <strong><%= presalesCase.estimatedValue !== null ? formatMoney(presalesCase.estimatedValue, presalesCase.currency) : `%${presalesCase.qualificationScore} hazırlık` %></strong>
              <small>%<%= presalesCase.qualificationScore %> yeterlilik · <%= presalesCase.openActionCount %> aksiyon · <%= presalesCase.issueCount %> bulgu</small>
            </span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="presales-empty">
        <h3>İlk presales dosyanı oluştur</h3>
        <p>Müşteri talebini tek dosyada aç; şartname, kitlist, ürün ve rekabet kayıtlarını altında ilerlet.</p>
      </div>
    <% } %>
  </section>

  <section class="presales-section presales-create" id="new-presales-case" aria-labelledby="new-presales-title">
    <div class="presales-section-heading">
      <div>
        <p class="eyebrow">Yeni çalışma</p>
        <h2 id="new-presales-title">Presales dosyası aç</h2>
      </div>
    </div>
    <form action="/presales" method="post" class="presales-form">
      <div class="presales-form-grid">
        <label class="field field-wide">
          <span>Dosya / proje adı</span>
          <input name="title" required placeholder="Kurum - Sunucu yenileme projesi">
        </label>
        <label class="field">
          <span>Müşteri / kurum</span>
          <input name="customer" placeholder="Kurum adı">
        </label>
        <label class="field">
          <span>İhale / fırsat referansı</span>
          <input name="tenderReference" placeholder="2026/12345 veya CRM no">
        </label>
        <label class="field">
          <span>Mevcut aşama</span>
          <select name="stage">
            <% presalesStages.forEach((stage) => { %><option value="<%= stage.value %>"><%= stage.label %></option><% }) %>
          </select>
        </label>
        <label class="field"><span>Fırsat türü</span><select name="opportunityType"><% opportunityTypes.forEach((type) => { %><option value="<%= type.value %>"><%= type.label %></option><% }) %></select></label>
        <label class="field"><span>Öncelik</span><select name="priority"><% presalesPriorities.forEach((priority) => { %><option value="<%= priority.value %>"><%= priority.label %></option><% }) %></select></label>
        <label class="field">
          <span>Teklif kararı</span>
          <select name="offerability">
            <% offerabilityStatuses.forEach((status) => { %><option value="<%= status.value %>"><%= status.label %></option><% }) %>
          </select>
        </label>
        <%- include('presales-product-list', { products: [] }) %>
        <label class="field">
          <span>Sorumlu</span>
          <input name="owner" placeholder="Presales / satış sorumlusu">
        </label>
        <label class="field">
          <span>Son teslim tarihi</span>
          <input name="deadline" type="datetime-local">
        </label>
        <label class="field"><span>İç teslim tarihi</span><input name="internalDeadline" type="datetime-local"><small>Müşteri termininden önceki iç kalite kapısı</small></label>
        <label class="field">
          <span>Dosya hatırlatması</span>
          <input name="reminderAt" type="datetime-local">
          <small>Son teslim tarihinden önce olmalı</small>
        </label>
        <label class="field"><span>Para birimi</span><select name="currency"><% currencies.forEach((currency) => { %><option value="<%= currency.value %>"><%= currency.label %></option><% }) %></select></label>
        <label class="field"><span>Tahmini teklif bedeli</span><input name="estimatedValue" type="number" min="0" step="0.01"></label>
        <label class="field"><span>Yaklaşık maliyet</span><input name="estimatedCost" type="number" min="0" step="0.01"></label>
        <label class="field"><span>Kazanma olasılığı</span><input name="winProbability" type="number" min="0" max="100" step="5" value="0"></label>
        <label class="field field-wide">
          <span>Rakipler / alternatifler</span>
          <input name="competitors" placeholder="Rakip marka ve modeller; segment farklarını ayrıca kaydet">
        </label>
        <label class="field field-wide">
          <span>Sonraki aksiyon</span>
          <input name="nextAction" placeholder="Üreticiden SKU teyidi al, BOM'u revize et...">
        </label>
        <label class="field field-wide">
          <span>Dosya notları</span>
          <textarea name="notes" rows="4" placeholder="Kapsam, lokasyon, adet, destek seviyesi, varsayımlar ve önemli bağlam"></textarea>
        </label>
      </div>
      <div class="form-actions">
        <button class="primary-button" type="submit">Dosyayı oluştur</button>
      </div>
    </form>
  </section>
</div>
