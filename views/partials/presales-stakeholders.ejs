<section class="presales-section stakeholder-section" id="stakeholders" aria-labelledby="stakeholders-title">
  <header class="presales-section-heading">
    <div><p class="eyebrow">Karar ağı</p><h2 id="stakeholders-title">Paydaş haritası</h2></div>
    <span class="section-count"><%= stakeholders.length %> kişi</span>
  </header>

  <% if (stakeholders.length) { %>
    <div class="stakeholder-list">
      <% stakeholders.forEach((stakeholder) => { %>
        <details class="stakeholder-row">
          <summary>
            <span class="stakeholder-avatar" aria-hidden="true"><%= stakeholder.name.slice(0, 1).toLocaleUpperCase('tr-TR') %></span>
            <span><strong><%= stakeholder.name %></strong><small><%= [stakeholder.organization, stakeholder.roleMeta.label].filter(Boolean).join(' · ') %></small></span>
            <span class="status-chip status-<%= stakeholder.stanceMeta.tone %>"><%= stakeholder.stanceMeta.label %></span>
            <small><%= stakeholder.influence === 'high' ? 'Yüksek etki' : stakeholder.influence === 'low' ? 'Düşük etki' : 'Orta etki' %></small>
          </summary>
          <form action="/presales/<%= presalesCase.id %>/stakeholders/<%= stakeholder.id %>" method="post" class="presales-form compact-form">
            <div class="presales-form-grid stakeholder-form-grid">
              <label class="field"><span>Ad soyad</span><input name="name" required value="<%= stakeholder.name %>"></label>
              <label class="field"><span>Kurum / birim</span><input name="organization" value="<%= stakeholder.organization %>"></label>
              <label class="field"><span>Rol</span><select name="role"><% stakeholderRoles.forEach((role) => { %><option value="<%= role.value %>" <%= stakeholder.role === role.value ? 'selected' : '' %>><%= role.label %></option><% }) %></select></label>
              <label class="field"><span>Etki</span><select name="influence"><% stakeholderInfluence.forEach((item) => { %><option value="<%= item.value %>" <%= stakeholder.influence === item.value ? 'selected' : '' %>><%= item.label %></option><% }) %></select></label>
              <label class="field"><span>Tutum</span><select name="stance"><% stakeholderStances.forEach((item) => { %><option value="<%= item.value %>" <%= stakeholder.stance === item.value ? 'selected' : '' %>><%= item.label %></option><% }) %></select></label>
              <label class="field"><span>İletişim</span><input name="contact" value="<%= stakeholder.contact %>"></label>
              <label class="field field-wide"><span>Not</span><textarea name="notes" rows="2"><%= stakeholder.notes %></textarea></label>
            </div>
            <div class="form-actions"><button class="primary-button" type="submit">Paydaşı güncelle</button></div>
          </form>
          <form action="/presales/<%= presalesCase.id %>/stakeholders/<%= stakeholder.id %>/delete" method="post" class="delete-form inline-delete" data-confirm="Bu paydaş kaydı silinsin mi?"><button type="submit">Sil</button></form>
        </details>
      <% }) %>
    </div>
  <% } else { %>
    <div class="presales-empty compact-empty"><h3>Karar ağı henüz görünür değil</h3><p>Ekonomik karar verici, teknik karar verici, iç destekçi ve satın alma rollerini ekle.</p></div>
  <% } %>

  <details class="inline-create">
    <summary>+ Paydaş ekle</summary>
    <form action="/presales/<%= presalesCase.id %>/stakeholders" method="post" class="presales-form compact-form">
      <div class="presales-form-grid stakeholder-form-grid">
        <label class="field"><span>Ad soyad</span><input name="name" required></label>
        <label class="field"><span>Kurum / birim</span><input name="organization"></label>
        <label class="field"><span>Rol</span><select name="role"><% stakeholderRoles.forEach((role) => { %><option value="<%= role.value %>"><%= role.label %></option><% }) %></select></label>
        <label class="field"><span>Etki</span><select name="influence"><% stakeholderInfluence.forEach((item) => { %><option value="<%= item.value %>"><%= item.label %></option><% }) %></select></label>
        <label class="field"><span>Tutum</span><select name="stance"><% stakeholderStances.forEach((item) => { %><option value="<%= item.value %>"><%= item.label %></option><% }) %></select></label>
        <label class="field"><span>İletişim</span><input name="contact" placeholder="E-posta veya telefon"></label>
        <label class="field field-wide"><span>Not</span><textarea name="notes" rows="2"></textarea></label>
      </div>
      <div class="form-actions"><button class="primary-button" type="submit">Paydaşı ekle</button></div>
    </form>
  </details>
</section>
