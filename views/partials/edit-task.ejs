<div class="edit-card">
  <% if (task.completedAt) { %>
    <div class="completed-banner">Bu iş tamamlandı. Kaydını yine de düzenleyebilir veya silebilirsin.</div>
  <% } %>
  <div class="task-health" aria-label="İş durumu">
    <div>
      <span class="status-chip status-<%= task.statusMeta.tone %>"><%= task.statusMeta.label %></span>
      <strong>%<%= task.progress %> tamamlandı</strong>
    </div>
    <progress max="100" value="<%= task.progress %>"><%= task.progress %>%</progress>
  </div>
  <form action="/tasks/<%= task.id %>" method="post" class="edit-form">
    <input type="hidden" name="returnTo" value="<%= returnTo %>">
    <label class="field field-wide">
      <span>İş başlığı</span>
      <input name="title" value="<%= task.title %>" required autofocus>
    </label>
    <label class="field field-wide">
      <span>Açıklama ve ayrıntılar</span>
      <textarea name="notes" rows="6" placeholder="Amaç, teslimat ölçütleri, bağlantılar ve gerekli tüm ayrıntılar"><%= task.notes %></textarea>
    </label>
    <div class="form-grid">
      <label class="field">
        <span>Proje</span>
        <span class="input-prefix"><b>#</b><input name="project" value="<%= task.project || '' %>" placeholder="ofis"></span>
      </label>
      <label class="field">
        <span>Öncelik</span>
        <select name="priority">
          <option value="" <%= !task.priority ? 'selected' : '' %>>Öncelik yok</option>
          <option value="1" <%= task.priority === 1 ? 'selected' : '' %>>P1 · Acil</option>
          <option value="2" <%= task.priority === 2 ? 'selected' : '' %>>P2 · Önemli</option>
          <option value="3" <%= task.priority === 3 ? 'selected' : '' %>>P3 · Normal</option>
        </select>
      </label>
      <label class="field">
        <span>Aşama</span>
        <select name="status" <%= task.completedAt ? 'disabled' : '' %>>
          <% if (task.completedAt) { %>
            <option value="completed" selected>Tamamlandı</option>
          <% } else { %>
            <% taskStatuses.forEach((status) => { %>
              <option value="<%= status.value %>" <%= task.status === status.value ? 'selected' : '' %>><%= status.label %></option>
            <% }) %>
          <% } %>
        </select>
      </label>
      <label class="field progress-field">
        <span>İlerleme <output data-progress-output>%<%= task.progress %></output></span>
        <input name="progress" type="range" min="0" max="100" step="5" value="<%= task.progress %>" <%= task.completedAt ? 'disabled' : '' %>>
        <small>İşin tamamlanma düzeyini yüzde olarak güncelle</small>
      </label>
      <label class="field">
        <span>Son tarih</span>
        <input name="dueAt" type="datetime-local" value="<%= toDateTimeInput(task.dueAt) %>">
      </label>
      <label class="field">
        <span>Özel hatırlatma</span>
        <input name="reminderAt" type="datetime-local" value="<%= toDateTimeInput(task.reminderAt) %>">
        <small>Son tarihten önce olmalı · <%= config.notificationsEnabled ? 'ntfy etkin' : 'ntfy henüz ayarlı değil' %></small>
      </label>
      <label class="field">
        <span>Tekrar</span>
        <input name="recurrence" value="<%= task.recurrence || '' %>" placeholder="her pazartesi,perşembe">
        <small>Türkçe tekrar ifadesi veya standart RRULE</small>
      </label>
    </div>
    <div class="form-actions">
      <button class="primary-button" type="submit">Değişiklikleri kaydet</button>
      <a class="secondary-button" href="<%= returnTo %>">Vazgeç</a>
    </div>
  </form>
  <section class="activity-section" aria-labelledby="activity-title">
    <div class="activity-heading">
      <div>
        <p class="eyebrow">Çalışma günlüğü</p>
        <h2 id="activity-title">İş notları</h2>
      </div>
      <span><%= taskNotes.length %> kayıt</span>
    </div>
    <form action="/tasks/<%= task.id %>/notes" method="post" class="note-form">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <label class="field">
        <span>Yeni not</span>
        <textarea name="content" rows="3" required placeholder="Görüşme sonucu, alınan karar, engel veya bir sonraki adım..."></textarea>
      </label>
      <button class="primary-button" type="submit">Notu kaydet</button>
    </form>
    <% if (taskNotes.length) { %>
      <div class="note-timeline">
        <% taskNotes.forEach((note) => { %>
          <article>
            <time datetime="<%= note.createdAt %>"><%= note.createdLabel %></time>
            <p><%= note.content %></p>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="activity-empty">Henüz çalışma notu yok. İlk gelişmeyi yukarıdan kaydedebilirsin.</p>
    <% } %>
  </section>
  <div class="secondary-actions">
    <% if (task.completedAt) { %>
      <form action="/tasks/<%= task.id %>/reopen" method="post">
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <button type="submit">İşi yeniden aç</button>
      </form>
    <% } else { %>
      <form action="/tasks/<%= task.id %>/duplicate" method="post">
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <button type="submit">Bir kopyasını oluştur</button>
      </form>
    <% } %>
    <form action="/tasks/<%= task.id %>/delete" method="post" class="delete-form" data-confirm="Bu iş kalıcı olarak silinsin mi?">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <button type="submit">İşi sil</button>
    </form>
  </div>
</div>
