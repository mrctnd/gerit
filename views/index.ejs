<%
  const appearance = appearancePreferences || { theme: 'atlas', font: 'modern', motion: 'system', scale: 100 };
  const themeColors = {
    atlas: '#102a43',
    forest: '#143a32',
    violet: '#302451',
    ember: '#3b2a2a',
  };
  const selectedAppearance = (key, value) => appearance[key] === value ? 'true' : 'false';
%>
<!doctype html>
<html lang="tr" data-theme="<%= appearance.theme %>" data-font="<%= appearance.font %>" data-motion="<%= appearance.motion %>" data-scale="<%= appearance.scale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Görev ve presales çalışmalarını yerel olarak yöneten kişisel çalışma merkezi.">
    <meta name="theme-color" content="<%= themeColors[appearance.theme] || themeColors.atlas %>">
    <title><%= view.title %> · Gerit</title>
    <link rel="icon" type="image/png" href="/brand/gerit-mark.png">
    <link rel="apple-touch-icon" href="/brand/gerit-mark.png">
    <script src="/preferences.js?v=<%= assetVersion %>"></script>
    <link rel="stylesheet" href="/styles.css?v=<%= assetVersion %>">
    <script src="/app.js?v=<%= assetVersion %>" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/today" aria-label="Gerit ana sayfa">
          <span class="brand-mark" aria-hidden="true"><img src="/brand/gerit-mark.png" alt=""></span>
          <span>
            <strong>Gerit</strong>
            <small>görev ve presales merkezi</small>
          </span>
        </a>

        <nav class="primary-nav" aria-label="İş görünümleri">
          <a class="nav-item presales-nav <%= currentPath === '/presales' || /^\/presales\/\d/.test(currentPath) ? 'active' : '' %>" href="/presales">
            <span class="nav-icon" aria-hidden="true">◆</span>
            <span>Presales Merkezi</span>
            <% if (presalesSummary.active) { %><span class="nav-count"><%= presalesSummary.active %></span><% } %>
          </a>
          <a class="nav-item attention-nav <%= currentPath === '/presales/attention' ? 'active' : '' %>" href="/presales/attention">
            <span class="nav-icon" aria-hidden="true">!</span>
            <span>Aksiyon Merkezi</span>
            <% if (attentionCount) { %><span class="nav-count nav-count-alert"><%= attentionCount %></span><% } %>
          </a>
          <a class="nav-item <%= currentPath === '/today' ? 'active' : '' %>" href="/today">
            <span class="nav-icon" aria-hidden="true">●</span>
            <span>Bugün</span>
            <% if (counts.today) { %><span class="nav-count"><%= counts.today %></span><% } %>
          </a>
          <a class="nav-item <%= currentPath === '/upcoming' ? 'active' : '' %>" href="/upcoming">
            <span class="nav-icon calendar-icon" aria-hidden="true">▦</span>
            <span>Yaklaşan</span>
            <% if (counts.upcoming) { %><span class="nav-count"><%= counts.upcoming %></span><% } %>
          </a>
          <a class="nav-item <%= currentPath === '/inbox' ? 'active' : '' %>" href="/inbox">
            <span class="nav-icon" aria-hidden="true">⌄</span>
            <span>Gelen Kutusu</span>
            <% if (counts.inbox) { %><span class="nav-count"><%= counts.inbox %></span><% } %>
          </a>
          <a class="nav-item <%= currentPath === '/workflow' ? 'active' : '' %>" href="/workflow">
            <span class="nav-icon workflow-icon" aria-hidden="true">◫</span>
            <span>İş Akışı</span>
            <% if (counts.workflow) { %><span class="nav-count"><%= counts.workflow %></span><% } %>
          </a>
          <a class="nav-item <%= currentPath === '/completed' ? 'active' : '' %>" href="/completed">
            <span class="nav-icon completed-icon" aria-hidden="true">✓</span>
            <span>Tamamlananlar</span>
            <% if (counts.completed) { %><span class="nav-count"><%= counts.completed %></span><% } %>
          </a>
        </nav>

        <section class="projects" aria-labelledby="projects-title">
          <div class="sidebar-heading">
            <span id="projects-title">Projeler</span>
            <span aria-hidden="true">#</span>
          </div>
          <div class="project-list">
            <% if (!projects.length) { %>
              <p class="projects-empty">Bir işe <strong>#ofis</strong> ekleyerek ilk projeni başlat.</p>
            <% } %>
            <% projects.forEach((project, index) => { %>
              <% const projectPath = `/projects/${encodeURIComponent(project.name)}`; %>
              <a class="project-link <%= currentPath === projectPath ? 'active' : '' %>" href="<%= projectPath %>">
                <span class="project-dot color-<%= index % 5 %>" aria-hidden="true"></span>
                <span><%= project.name %></span>
                <span class="nav-count"><%= project.count %></span>
              </a>
            <% }) %>
          </div>
        </section>

        <div class="shortcut-card" aria-label="Klavye kısayolları">
          <p>Klavye ile hızlan</p>
          <div><span><kbd>N</kbd> Yeni iş</span><span><kbd>/</kbd> Arama</span></div>
          <div><span><kbd>X</kbd> Tamamla</span><span><kbd>J K</kbd> Gezin</span></div>
          <div><span><kbd>G</kbd> Görünüm</span><span>Yerel tercih</span></div>
        </div>
      </aside>

      <main class="main-content" id="main-content">
        <header class="topbar">
          <a class="mobile-brand" href="/today" aria-label="Gerit ana sayfa"><span><img src="/brand/gerit-mark.png" alt=""></span> Gerit</a>
          <form class="search-form" action="/search" method="get" role="search">
            <label class="sr-only" for="global-search">Görev ve presales dosyalarında ara</label>
            <span class="search-icon" aria-hidden="true"></span>
            <input id="global-search" name="q" type="search" value="<%= view.searchQuery || '' %>" placeholder="Görev, müşteri, SKU veya model ara" autocomplete="off">
            <kbd>/</kbd>
          </form>
          <button class="appearance-trigger" id="appearance-trigger" type="button" aria-haspopup="dialog" aria-controls="appearance-dialog">
            <span class="appearance-trigger-icon" aria-hidden="true"></span>
            <span class="appearance-trigger-label">Görünüm</span>
            <kbd>G</kbd>
          </button>
          <a class="attention-trigger <%= attentionCount ? 'has-alerts' : '' %>" href="/presales/attention" title="Aksiyon ve Uyarı Merkezi">
            <span aria-hidden="true">!</span>
            <span>Uyarılar</span>
            <% if (attentionCount) { %><b><%= attentionCount %></b><% } %>
          </a>
          <div class="local-badge <%= config.notificationsEnabled ? 'notifications-on' : '' %>" title="<%= config.notificationMode === 'desktop' ? 'Yerel masaüstü bildirimleri etkin' : config.notificationsEnabled ? 'ntfy bildirimleri etkin' : 'Bildirimler için NTFY_TOPIC ayarlayın' %>">
            <span aria-hidden="true"></span> <%= config.notificationMode === 'desktop' ? 'Yerel bildirim' : config.notificationsEnabled ? 'Bildirim açık' : 'Şirket içi' %>
          </div>
          <% if (config.notificationsEnabled) { %>
            <form class="notification-test-form" action="/notifications/test" method="post">
              <input type="hidden" name="returnTo" value="<%= returnPath %>">
              <button type="submit" title="Bildirim dene" aria-label="Bildirim dene">
                <span aria-hidden="true">♢</span>
                <span>Dene</span>
              </button>
            </form>
          <% } %>
        </header>

        <div class="page-wrap">
          <section class="page-heading">
            <div>
              <p class="eyebrow"><%= view.kicker %></p>
              <h1><%= view.title %></h1>
            </div>
            <% if (!['edit', 'presales-dashboard', 'presales-case', 'presales-attention'].includes(view.kind)) { %>
              <p class="page-hint"><kbd>N</kbd> ile ekle · <kbd>X</kbd> ile tamamla</p>
            <% } %>
          </section>

          <% if (currentPath === '/today') { %>
            <section class="work-summary" aria-label="Günün iş özeti">
              <article>
                <span>Açık işler</span>
                <strong><%= summary.open %></strong>
                <small>tüm projelerde</small>
              </article>
              <article class="summary-active">
                <span>Devam eden</span>
                <strong><%= summary.inProgress %></strong>
                <small><%= summary.blocked ? `${summary.blocked} iş bloke` : 'aktif yürütülen' %></small>
              </article>
              <article>
                <span>Bugün</span>
                <strong><%= summary.dueToday %></strong>
                <small>planlanmış iş</small>
              </article>
              <article class="<%= summary.overdue ? 'summary-danger' : '' %>">
                <span>Geciken</span>
                <strong><%= summary.overdue %></strong>
                <small><%= summary.overdue ? 'önce bunlara odaklan' : 'her şey yolunda' %></small>
              </article>
              <article class="summary-success">
                <span>Tamamlanan</span>
                <strong><%= summary.completedToday %></strong>
                <small>bugünkü ilerleme</small>
              </article>
            </section>
          <% } %>

          <% if (!['edit', 'message', 'presales-dashboard', 'presales-case', 'presales-attention'].includes(view.kind)) { %>
            <section class="quick-add-card" aria-labelledby="quick-add-title">
              <form action="/tasks" method="post" id="quick-add-form">
                <input type="hidden" name="returnTo" value="<%= returnPath %>">
                <div class="quick-add-main">
                  <span class="quick-plus" aria-hidden="true">+</span>
                  <label class="sr-only" id="quick-add-title" for="quick-add">Yeni iş ekle</label>
                  <input id="quick-add" name="quick" required autocomplete="off" placeholder="Teklifi yarın 16:00 gönder #satış p1">
                  <button type="submit">İşi ekle <kbd>↵</kbd></button>
                </div>
                <details class="quick-details">
                  <summary>Aşama, not, hatırlatma ve tekrar ekle</summary>
                  <div class="quick-detail-grid">
                    <label>
                      <span>Notlar</span>
                      <input name="notes" placeholder="Hatırlaman gereken ayrıntılar">
                    </label>
                    <label>
                      <span>Aşama</span>
                      <select name="status">
                        <% taskStatuses.forEach((status) => { %>
                          <option value="<%= status.value %>"><%= status.label %></option>
                        <% }) %>
                      </select>
                    </label>
                    <label>
                      <span>Özel hatırlatma</span>
                      <input name="reminderAt" type="datetime-local">
                    </label>
                    <label>
                      <span>Tekrar</span>
                      <input name="repeat" placeholder="her ayın 1’i veya her pazartesi,perşembe">
                    </label>
                  </div>
                </details>
              </form>
              <p class="syntax-hint"><span>Örnek</span> “Raporu <strong>yarın 16:00</strong> gönder <b>#finans</b> <em>p2</em>”</p>
            </section>
          <% } %>

          <section class="task-surface" aria-live="polite">
            <% if (view.kind === 'edit') { %>
              <%- include('partials/edit-task', { task: view.task, taskNotes: view.taskNotes, returnTo: view.returnTo }) %>
            <% } else if (view.kind === 'presales-dashboard') { %>
              <%- include('partials/presales-dashboard', { cases: view.cases }) %>
            <% } else if (view.kind === 'presales-case') { %>
              <%- include('partials/presales-case', { presalesCase: view.presalesCase, records: view.records, metrics: view.metrics, qualification: view.qualification, stakeholders: view.stakeholders, actions: view.actions }) %>
            <% } else if (view.kind === 'presales-attention') { %>
              <%- include('partials/presales-attention', { items: view.items }) %>
            <% } else { %>
              <% const groups = view.kind === 'grouped' ? view.groups : [{ title: null, tone: 'default', tasks: view.tasks || [] }]; %>
              <% const totalTasks = groups.reduce((sum, group) => sum + group.tasks.length, 0); %>

              <% if (!totalTasks && !(view.presalesResults && view.presalesResults.length)) { %>
                <div class="empty-state">
                  <span aria-hidden="true">✓</span>
                  <h2><%= view.emptyTitle %></h2>
                  <p><%= view.emptyCopy %></p>
                  <% if (view.kind === 'message') { %><a href="/today">Bugün'e dön</a><% } %>
                </div>
              <% } else { %>
                <% groups.forEach((group) => { %>
                  <% if (group.tasks.length) { %>
                    <section class="task-group <%= group.tone === 'danger' ? 'danger-group' : '' %>">
                      <% if (group.title) { %>
                        <div class="group-heading">
                          <h2><%= group.title %></h2>
                          <span><%= group.tasks.length %></span>
                        </div>
                      <% } %>
                      <div class="task-list">
                        <% group.tasks.forEach((task) => { %>
                          <%- include('partials/task-row', { task }) %>
                        <% }) %>
                      </div>
                    </section>
                  <% } %>
                <% }) %>
              <% } %>
              <% if (view.presalesResults && view.presalesResults.length) { %>
                <section class="presales-search-results" aria-labelledby="presales-search-title">
                  <div class="group-heading">
                    <h2 id="presales-search-title">Presales dosyaları</h2>
                    <span><%= view.presalesResults.length %></span>
                  </div>
                  <div class="presales-case-list">
                    <% view.presalesResults.forEach((presalesCase) => { %>
                      <a class="presales-case-row" href="/presales/<%= presalesCase.id %>">
                        <span><strong><%= presalesCase.title %></strong><small><%= [presalesCase.customer, presalesCase.tenderReference].filter(Boolean).join(' · ') || 'Presales dosyası' %></small></span>
                        <span class="status-chip status-<%= presalesCase.stageMeta.tone %>"><%= presalesCase.stageMeta.label %></span>
                      </a>
                    <% }) %>
                  </div>
                </section>
              <% } %>
            <% } %>
          </section>
        </div>

        <footer class="app-footer">
          <span><span class="footer-dot" aria-hidden="true"></span> Değişiklikler otomatik kaydedilir</span>
          <span><%= config.timezone %></span>
        </footer>
      </main>
    </div>

    <dialog class="appearance-dialog" id="appearance-dialog" aria-labelledby="appearance-title">
      <div class="appearance-panel">
        <header class="appearance-header">
          <div>
            <p class="eyebrow">Kişiselleştir</p>
            <h2 id="appearance-title">Gerit senin gibi çalışsın</h2>
          </div>
          <button class="appearance-close" type="button" data-close-appearance aria-label="Görünüm ayarlarını kapat">×</button>
        </header>

        <section class="appearance-section" aria-labelledby="palette-title">
          <div class="appearance-section-heading">
            <h3 id="palette-title">Renk paleti</h3>
            <span>Dört dengeli çalışma modu</span>
          </div>
          <div class="palette-grid" role="group" aria-label="Renk paleti seçimi">
            <button class="palette-option" type="button" data-theme-option="atlas" aria-pressed="<%= selectedAppearance('theme', 'atlas') %>">
              <span class="palette-preview palette-atlas" aria-hidden="true"><i></i><i></i><i></i></span>
              <span><strong>Atlas</strong><small>Lacivert · Turkuaz</small></span>
              <b aria-hidden="true">✓</b>
            </button>
            <button class="palette-option" type="button" data-theme-option="forest" aria-pressed="<%= selectedAppearance('theme', 'forest') %>">
              <span class="palette-preview palette-forest" aria-hidden="true"><i></i><i></i><i></i></span>
              <span><strong>Orman</strong><small>Çam · Nane</small></span>
              <b aria-hidden="true">✓</b>
            </button>
            <button class="palette-option" type="button" data-theme-option="violet" aria-pressed="<%= selectedAppearance('theme', 'violet') %>">
              <span class="palette-preview palette-violet" aria-hidden="true"><i></i><i></i><i></i></span>
              <span><strong>Lavanta</strong><small>Mürdüm · Leylak</small></span>
              <b aria-hidden="true">✓</b>
            </button>
            <button class="palette-option" type="button" data-theme-option="ember" aria-pressed="<%= selectedAppearance('theme', 'ember') %>">
              <span class="palette-preview palette-ember" aria-hidden="true"><i></i><i></i><i></i></span>
              <span><strong>Kehribar</strong><small>Kömür · Mercan</small></span>
              <b aria-hidden="true">✓</b>
            </button>
          </div>
        </section>

        <section class="appearance-section" aria-labelledby="font-title">
          <div class="appearance-section-heading">
            <h3 id="font-title">Yazı karakteri</h3>
            <span>Dış bağlantı gerektirmeyen yerel font setleri</span>
          </div>
          <div class="font-grid" role="group" aria-label="Yazı karakteri seçimi">
            <button class="font-option" type="button" data-font-option="modern" aria-pressed="<%= selectedAppearance('font', 'modern') %>"><b>Aa</b><span>Modern</span><small>Temiz ve dengeli</small></button>
            <button class="font-option" type="button" data-font-option="humanist" aria-pressed="<%= selectedAppearance('font', 'humanist') %>"><b>Aa</b><span>Humanist</span><small>Sıcak ve okunaklı</small></button>
            <button class="font-option" type="button" data-font-option="editorial" aria-pressed="<%= selectedAppearance('font', 'editorial') %>"><b>Aa</b><span>Editoryal</span><small>Klasik ve ciddi</small></button>
            <button class="font-option" type="button" data-font-option="mono" aria-pressed="<%= selectedAppearance('font', 'mono') %>"><b>Aa</b><span>Teknik</span><small>Keskin ve ritmik</small></button>
          </div>
        </section>

        <section class="appearance-section motion-section" aria-labelledby="motion-title">
          <div class="appearance-section-heading">
            <h3 id="motion-title">Hareket</h3>
            <span>Geçiş yoğunluğunu seç</span>
          </div>
          <div class="motion-options" role="group" aria-label="Hareket tercihi">
            <button type="button" data-motion-option="system" aria-pressed="<%= selectedAppearance('motion', 'system') %>">Sistemi izle</button>
            <button type="button" data-motion-option="full" aria-pressed="<%= selectedAppearance('motion', 'full') %>">Akıcı</button>
            <button type="button" data-motion-option="reduced" aria-pressed="<%= selectedAppearance('motion', 'reduced') %>">Sakin</button>
          </div>
          <div class="motion-preview" aria-hidden="true">
            <span><i data-motion-preview-marker></i></span>
            <small data-motion-preview-label><%= appearance.motion === 'full' ? 'Akıcı' : appearance.motion === 'reduced' ? 'Sakin' : 'Sistemi izle' %></small>
          </div>
        </section>

        <section class="appearance-section scale-section" aria-labelledby="scale-title">
          <div class="appearance-section-heading">
            <h3 id="scale-title">Arayüz ölçeği</h3>
            <output for="ui-scale" data-scale-output>%<%= appearance.scale %></output>
          </div>
          <div class="scale-control">
            <button type="button" class="scale-step" data-scale-step="-5" aria-label="Arayüzü küçült" title="Arayüzü küçült">−</button>
            <input id="ui-scale" data-scale-input type="range" min="80" max="160" step="5" value="<%= appearance.scale %>" aria-label="Arayüz ölçeği">
            <button type="button" class="scale-step" data-scale-step="5" aria-label="Arayüzü büyüt" title="Arayüzü büyüt">+</button>
          </div>
        </section>

        <footer class="appearance-footer">
          <p><span aria-hidden="true">●</span> Tercihler bu bilgisayarın yerel veritabanında saklanır.</p>
          <button type="button" class="reset-appearance" data-reset-appearance>Varsayılana dön</button>
        </footer>
      </div>
    </dialog>
    <p class="sr-only" id="appearance-status" role="status" aria-live="polite"></p>
  </body>
</html>
